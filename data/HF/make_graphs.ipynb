    "xs = []\n",
    "ys = []\n",
    "zs = []\n",
    "BSSE_As = []\n",
    "BSSE_Bs = []\n",
    "with open(\"BSSE_by_FF_distance.csv\", \"r\") as f:\n",
    "    next(f)\n",
    "    for line in f:\n",
    "        _, x, y, z, BSSE_A, BSSE_B = line.strip().split(\",\")\n",
    "        x = float(x.replace(\"(\", \"\"))\n",
    "        y = float(y)\n",
    "        z = float(z.replace(\")\", \"\"))\n",
    "        xs.append(x)\n",
    "        ys.append(y)\n",
    "        zs.append(z)\n",
    "        BSSE_As.append(float(BSSE_A))\n",
