# load_dimers.pml
# PyMOL loader for HF dimer translational configurations
# 268 configurations, aug-cc-pVDZ
#
# Usage — run from HF/2/:
#     pymol load_dimers.pml
#
# Each configuration is loaded as a separate object named
# after its config label (n_x_y_z).

# Display settings
set antialias, 2
set ray_opaque_background, off
set stick_quality, 16
set sphere_quality, 4
set ray_trace_mode, 1

# Load all translational xyz files
load pymol_xyz/FF_distance_0.25_0.25_1.5.xyz, 0_0.25_0.25_1.5
load pymol_xyz/FF_distance_0.25_0.25_1.75.xyz, 1_0.25_0.25_1.75
